{
  "name": "clickpilot",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "corepack pnpm --filter @clickpilot/extension build && corepack pnpm --filter @clickpilot/api build",
    "package:extension": "node scripts/package-extension.mjs",
    "dev:api": "corepack pnpm --filter @clickpilot/api dev",
    "lint": "eslint apps/extension apps/api packages/shared",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm build && playwright test",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "verify:api": "corepack pnpm --filter @clickpilot/api verify:local"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0"
  }
}
