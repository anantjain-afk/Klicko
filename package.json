{
  "name": "clickpilot",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "corepack pnpm --filter @clickpilot/extension build",
    "lint": "eslint apps/extension",
    "test": "corepack pnpm --filter @clickpilot/extension test",
    "test:e2e": "corepack pnpm build && playwright test",
    "typecheck": "corepack pnpm --filter @clickpilot/extension typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0"
  }
}
