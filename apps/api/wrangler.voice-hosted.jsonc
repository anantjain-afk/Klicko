{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klicko-voice",
  "main": "src/voice-hosted.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["enable_request_signal"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "VOICE_HOSTED_ENABLED": "disabled",
    "VOICE_HOSTED_ORIGIN": ""
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "VOICE_RATE_LIMIT",
      "namespace_id": "426801",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
